# Precepta — self-host settings. Copy this file to `.env` and fill in the top
# three. Everything else is already set to the sovereign, in-boundary defaults —
# you can leave it alone.
#
#   cp deploy/.env.example deploy/.env

# ── Fill these in ────────────────────────────────────────────────────────────
ORG_NAME="My Organization"          # shown in the Console top bar
ADMIN_EMAIL="you@yourcompany.com"   # the first owner — sign in with this
PRECEPTA_PLATFORM_OWNERS="you@yourcompany.com"   # who can change sovereign settings (comma-separated)

# ── Sovereign defaults (leave as-is unless you know you need to change) ───────
# The router's own model + embeddings run in-boundary on the bundled Ollama.
# NO Hugging Face / public endpoints are configured — that's the point.
ROUTER_MODEL="llama3.2:3b"          # small, CPU-friendly router/intent model
EMBED_MODEL="nomic-embed-text"      # in-boundary embeddings (semantic cache)

# Sovereign Mode ON = only in-boundary endpoints may serve requests.
PRECEPTA_SOVEREIGN="true"

# ── Notes ────────────────────────────────────────────────────────────────────
# - The Console is published on 127.0.0.1:8000 (loopback). To reach it from
#   other machines on your LAN, change the app `ports` mapping in
#   docker-compose.yml to "0.0.0.0:8000:8000" (and put it behind your own TLS).
# - Do NOT commit your real `.env` — it is gitignored.
