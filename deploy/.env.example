# Precepta — self-host settings. Copy this file to `.env` and fill in the top
# three. Everything else is already set to the sovereign, in-boundary defaults —
# you can leave it alone.
#
#   cp deploy/.env.example deploy/.env

# ── Fill these in ────────────────────────────────────────────────────────────
ORG_NAME="My Organization"          # shown in the Console top bar
ADMIN_EMAIL="you@yourcompany.com"   # the first owner — sign in with this
PRECEPTA_PLATFORM_OWNERS="you@yourcompany.com"   # who can change sovereign settings (comma-separated)

# ── Sovereign defaults (leave as-is unless you know you need to change) ───────
# The router's own model + embeddings run in-boundary on the bundled Ollama.
# NO Hugging Face / public endpoints are configured — that's the point.
ROUTER_MODEL="llama3.2:3b"          # small, CPU-friendly router/intent model
EMBED_MODEL="nomic-embed-text"      # in-boundary embeddings (semantic cache)

# Sovereign Mode ON = only in-boundary endpoints may serve requests.
PRECEPTA_SOVEREIGN="true"

# The clone URL shown in the in-product Deployment runbook. Point it at your own
# fork/mirror if you host the code somewhere else.
PRECEPTA_REPO_URL="https://github.com/LiminaLabsAI/precepta.git"

# ── Sign in with Google / Enterprise SSO (OIDC) — optional ───────────────────
# Leave blank to keep the local-admin login (self-host default). To enable the
# "Sign in with Google" button you must do BOTH:
#
#  1) Create a Google OAuth 2.0 **Web application** client at
#     https://console.cloud.google.com/apis/credentials and set its
#     "Authorized redirect URI" to EXACTLY your OIDC_REDIRECT below, then paste
#     the client id/secret here:
# OIDC_ISSUER="https://accounts.google.com"
# OIDC_CLIENT_ID="xxxx.apps.googleusercontent.com"
# OIDC_CLIENT_SECRET="xxxx"
# OIDC_REDIRECT="https://console.preceptaai.com/auth/sso/callback"   # your real domain
# PRECEPTA_ADMIN_EMAILS="you@yourcompany.com"   # emails granted the admin role on login
#
#  2) Run the restricted-egress overlay so the app can reach Google (it is
#     zero-egress by default). When the OIDC vars above point at Google, Precepta
#     AUTO-APPROVES Google's OIDC hosts (accounts.google.com, oauth2.googleapis.com,
#     openidconnect.googleapis.com, www.googleapis.com) into the egress allowlist at
#     startup — no manual approval needed. They show up in Console → Egress
#     (added_by system:oidc) and can be revoked. Enable the overlay with:
#       docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.egress.yml up -d --build
#     Without the overlay there is no path out, so sign-in fails even with creds set.

# ── Public demo (reach the Console at https://your-domain) — optional ─────────
# By default the Console is published only on 127.0.0.1:8000 (loopback). To put it
# on a public HTTPS URL (e.g. for a hosted demo or Google sign-in), run on a VM
# with a public IP, point your domain's DNS at it, open ports 80+443, then start
# with the public overlay — Caddy gets a real TLS cert automatically:
# PUBLIC_DOMAIN="console.preceptaai.com"
#   PUBLIC_DOMAIN=console.preceptaai.com \
#   docker compose -f deploy/docker-compose.yml \
#                  -f deploy/docker-compose.egress.yml \
#                  -f deploy/docker-compose.public.yml up -d --build
# (Include the egress overlay so Google sign-in can reach Google.) NOTE: this is a
# real server running the full stack — it cannot run on serverless hosts (Vercel,
# Netlify, Lambda): the bundled models, the persistent DB, and the internal
# network + egress broker all need an always-on container host.

# ── Notes ────────────────────────────────────────────────────────────────────
# - The Console is published on 127.0.0.1:8000 (loopback). To reach it from
#   other machines on your LAN, change the app `ports` mapping in
#   docker-compose.yml to "0.0.0.0:8000:8000" (and put it behind your own TLS).
# - Do NOT commit your real `.env` — it is gitignored.
