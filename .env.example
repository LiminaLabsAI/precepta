# preceptaai — local environment config.
# Copy this file to `.env` and fill in the values, then run ./run.sh
#   cp .env.example .env
# NOTE: .env holds secrets — do not commit it or share it.

# ─────────────── Enterprise SSO / Google login (OIDC) ───────────────
# For Google, the issuer is exactly this:
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=957284610590-rotsng2hmv8j0a5qocujj1lhsrs43i5k.apps.googleusercontent.com
# OIDC_CLIENT_SECRET=GOCSPX-your-secret-here
# OIDC_REDIRECT=http://127.0.0.1:8000/auth/sso/callback
#
# For Okta:   OIDC_ISSUER=https://<your-org>.okta.com/oauth2/default
# For Azure:  OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#
# Grant admin to specific emails (comma-separated). Everyone else defaults to 'user'.
# PRECEPTA_ADMIN_EMAILS=you@yourco.com,teammate@yourco.com

# ─────────────── Optional in-boundary model backends ───────────────
# VLLM_BASE_URL=http://10.0.4.12:8000/v1
# VLLM_API_KEY=sk-internal-...
# NEYSA_BASE_URL=https://your-org.neysa.ai
# NEYSA_API_KEY=neysa_live_...
# HF_BASE_URL=https://xxxxx.endpoints.huggingface.cloud
# HF_API_KEY=hf_...

# ─────────────── Behavior ───────────────
# PRECEPTA_REQUIRE_AUTH=1        # require a bearer token / login on the API
# PRECEPTA_SOVEREIGN=0           # disable Sovereign Mode (default: on)
